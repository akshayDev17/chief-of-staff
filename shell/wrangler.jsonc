// The shell Worker. No account or secrets here.
//
// Variables the deploy sets (never committed): ACCESS_TEAM_DOMAIN
// (`https://<team>.cloudflareaccess.com`) and ACCESS_AUD (the AUD tag of the
// Access application the portfolio-app tool makes over /chief-of-staff),
// both from the GitHub environment `production`, where the tool will write
// them once its requested change lands (README "Releasing the shell").
// Without both, the Worker refuses every request (src/access.ts).
{
  "name": "chief-of-staff-shell",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  // The app lives at akshayprabhakant.com/chief-of-staff (src/paths.ts). A
  // route pattern cannot hold a query, so this one pattern is the only one
  // that also matches `/chief-of-staff?<query>`; it matches sibling paths
  // such as `/chief-of-staff.html` too, which the Worker passes to the origin
  // untouched (src/index.ts; the portfolio-app README, "The app's Worker
  // route and its pass-through").
  "routes": [{ "pattern": "akshayprabhakant.com/chief-of-staff*", "zone_name": "akshayprabhakant.com" }],
  // The app's one D1 database. The id is a placeholder until T10 creates the
  // database on the owner's account (a database id is not secret); local
  // runs and tests never use it, and the release refuses to run with it.
  // Migrations are numbered .sql files in migrations/ (design-v3 8.4), applied
  // only by the release pipeline (README "Releasing the shell").
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chief-of-staff",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 06:00 UTC daily: refresh the price table from the vendors' price sources.
  // 07:00 UTC Mondays: remind the maintainers to re-read the listing prices.
  // Every minute: the provider checks whose next try is due (T16).
  "triggers": { "crons": ["0 6 * * *", "0 7 * * 1", "* * * * *"] },
  // A refresh reads every region's AWS price-list files; give it room.
  "limits": { "cpu_ms": 300000 }
  // GOOGLE_BILLING_API_KEY arrives as a Worker secret with T10; it is never
  // written here. So do the provider plug-ins' values (README "Connecting the
  // providers"): the secrets ISSUER_KEYS and ENTRA_CERT_KEY, and the
  // variables APP_ORIGIN, AWS_APP_ROLE_ARN, AWS_REGION, BEDROCK_TEMPLATE_URL,
  // ENTRA_CLIENT_ID, ENTRA_CERT_THUMBPRINT, FOUNDRY_CREDENTIAL,
  // GOOGLE_WIF_PROVIDER and GOOGLE_SERVICE_ACCOUNT, none of them secret. The vault key (32 random bytes, base64; src/vault.ts) goes
  // in Secrets Store as a binding with the first ticket that stores a vault
  // item; the three v1 provider connections need none.
}
