// The shell Worker. No account or secrets here.
//
// Variables the deploy sets (never committed): ACCESS_TEAM_DOMAIN
// (`<team>.cloudflareaccess.com`, as the tool writes it, or with `https://`)
// and ACCESS_AUD (the AUD tag of the Access application the portfolio-app
// tool makes over /chief-of-staff), both from the GitHub environment
// `production`, where the tool writes them (README "Releasing the shell").
// Without both, the Worker refuses every request (src/access.ts).
{
  "name": "chief-of-staff-shell",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  // The app's public origin (https://host, no path; src/app-config.ts
  // readAppOrigin): OpenRouter's consent page returns to
  // <APP_ORIGIN>/chief-of-staff. Not secret,
  // so it ships with every release; the release's --var values are added
  // alongside it.
  "vars": { "APP_ORIGIN": "https://akshayprabhakant.com" },
  // The app lives at akshayprabhakant.com/chief-of-staff (src/paths.ts). A
  // route pattern cannot hold a query, so this one pattern is the only one
  // that also matches `/chief-of-staff?<query>`; it matches sibling paths
  // such as `/chief-of-staff.html` too, which the Worker passes to the origin
  // untouched (src/index.ts; the portfolio-app README, "The app's Worker
  // route and its pass-through").
  "routes": [{ "pattern": "akshayprabhakant.com/chief-of-staff*", "zone_name": "akshayprabhakant.com" }],
  // The app's one D1 database, created on the owner's account by the
  // portfolio-app tool (a database id is not secret); local runs and tests
  // never use it, and the release refuses to run with the all-zero placeholder.
  // Migrations are numbered .sql files in migrations/ (design-v3 8.4), applied
  // only by the release pipeline (README "Releasing the shell").
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chief-of-staff",
      "database_id": "d6fce881-3520-4985-be4e-ec9468251599",
      "migrations_dir": "migrations"
    }
  ],
  // The Durable Object classes, declared with the `exports` map, never the
  // older `migrations` array (src/objects/README.md, "Declaring a class").
  // A class change here cannot be undone and a rollback cannot cross it, so
  // each is reviewed on its own; a `deleted` state removes the class's every
  // object and its storage, and never ships without the owner's word.
  "exports": {
    "Chief": { "type": "durable-object", "storage": "sqlite" },
    "Run": { "type": "durable-object", "storage": "sqlite" },
    "Owner": { "type": "durable-object", "storage": "sqlite" }
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHIEF", "class_name": "Chief" },
      { "name": "RUN", "class_name": "Run" },
      { "name": "OWNER", "class_name": "Owner" }
    ]
  },
  // 06:00 UTC daily: refresh the price table and model list from
  // OpenRouter's models API. Every minute: read any hosts the current price
  // snapshot's figures still wait for, which does nothing when none wait
  // (src/prices/host-reads.ts). The same strings as src/index.ts DAILY_CRON
  // and HOST_READ_CRON.
  "triggers": { "crons": ["0 6 * * *", "* * * * *"] }
  // The one secret is never written here: VAULT_KEY (32 random bytes,
  // base64; src/vault.ts, src/providers/secrets.ts), which seals the key
  // OpenRouter issues each user, stored with `npx wrangler secret put`
  // (README "Releasing the shell"), which a release keeps.
}
