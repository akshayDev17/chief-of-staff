{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Chief of staff: one role the app can assume, only with this account's external ID, that can call Amazon Bedrock models and accept Bedrock models' AWS Marketplace terms on first use. Delete this stack to remove the app's access.",
  "Metadata": {
    "TemplateVersion": "1.1.0",
    "MarketplaceProductIds": {
      "anthropic.claude-fable-5": "prod-h6swdfybvty7y",
      "anthropic.claude-fable-5-1": "prod-lt3y75wunrtv4",
      "anthropic.claude-fable-5-2": "prod-m733do2vrmi3o",
      "anthropic.claude-haiku-4-5-20251001-v1:0": "prod-xdkflymybwmvi",
      "anthropic.claude-haiku-5-5": "prod-6cyn7tgqazjhu",
      "anthropic.claude-opus-4-5-20251101-v1:0": "prod-jhuafngbly644",
      "anthropic.claude-opus-4-6-v1": "prod-5ukwuglpt66kg",
      "anthropic.claude-opus-4-7": "prod-d2ik6zgct5hxi",
      "anthropic.claude-opus-4-8": "prod-bk5rjg4eo2pke",
      "anthropic.claude-opus-5": "prod-if5d653ow7ehg",
      "anthropic.claude-opus-5-5": "prod-e5xo6z26ie45g",
      "anthropic.claude-sonnet-4-6": "prod-ffvjxvh4ltq64",
      "anthropic.claude-sonnet-5": "prod-4ezhkeia6k2cs",
      "anthropic.claude-sonnet-5-5": "prod-pjfguoisodbd6",
      "openai.gpt-5.4": "prod-3bbohv3635iau",
      "openai.gpt-5.5": "prod-indw4nwkcsyua",
      "openai.gpt-5.6-luna": "prod-bpeu2ptegwjfa",
      "openai.gpt-5.6-sol": "prod-k5bywj2464j7c",
      "openai.gpt-5.6-terra": "prod-oxu3iqwrwktjm",
      "openai.gpt-6-astra": "prod-hqau7gqhlqsrg",
      "openai.gpt-6-luna": "prod-fiwlckcpwkwli",
      "openai.gpt-6-sol": "prod-zpwu74hhojefo",
      "openai.gpt-6.1-sol": "prod-qco655ut2vn54",
      "openai.gpt-6.1-terra": "prod-xynumvnbsn34g",
      "openai.gpt-6.2-astra": "prod-e4mdsiazbjejo",
      "openai.gpt-6.2-sol": "prod-vznp63pbdpexe"
    }
  },
  "Parameters": {
    "ExternalId": {
      "Type": "String",
      "Description": "The external ID the app generated for this account (not secret). Filled in by the app's link.",
      "MinLength": 2,
      "MaxLength": 1224,
      "AllowedPattern": "[\\w+=,.@:\\/-]*"
    },
    "AppRoleArn": {
      "Type": "String",
      "Description": "The app's own role, the only principal this role trusts. Filled in by the app's link.",
      "AllowedPattern": "arn:aws:iam::\\d{12}:role/[\\w+=,.@/-]+"
    }
  },
  "Resources": {
    "ModelCallerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "chief-of-staff-model-caller",
        "Description": "Lets the Chief of staff app call Amazon Bedrock models and accept Bedrock models' AWS Marketplace terms on first use, and nothing else.",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "AWS": { "Ref": "AppRoleArn" } },
              "Action": "sts:AssumeRole",
              "Condition": { "StringEquals": { "sts:ExternalId": { "Ref": "ExternalId" } } }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "call-models-and-accept-their-terms",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "InvokeModels",
                  "Effect": "Allow",
                  "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
                  "Resource": [
                    "arn:aws:bedrock:*::foundation-model/*",
                    "arn:aws:bedrock:*:*:inference-profile/*",
                    "arn:aws:bedrock:*:*:application-inference-profile/*"
                  ]
                },
                {
                  "Sid": "AcceptBedrockModelTermsOnFirstUse",
                  "Effect": "Allow",
                  "Action": ["aws-marketplace:Subscribe", "aws-marketplace:Unsubscribe"],
                  "Resource": "*",
                  "Condition": {
                    "ForAnyValue:StringEquals": {
                      "aws-marketplace:ProductId": [
                        "prod-3bbohv3635iau",
                        "prod-4ezhkeia6k2cs",
                        "prod-5ukwuglpt66kg",
                        "prod-6cyn7tgqazjhu",
                        "prod-bk5rjg4eo2pke",
                        "prod-bpeu2ptegwjfa",
                        "prod-d2ik6zgct5hxi",
                        "prod-e4mdsiazbjejo",
                        "prod-e5xo6z26ie45g",
                        "prod-ffvjxvh4ltq64",
                        "prod-fiwlckcpwkwli",
                        "prod-h6swdfybvty7y",
                        "prod-hqau7gqhlqsrg",
                        "prod-if5d653ow7ehg",
                        "prod-indw4nwkcsyua",
                        "prod-jhuafngbly644",
                        "prod-k5bywj2464j7c",
                        "prod-lt3y75wunrtv4",
                        "prod-m733do2vrmi3o",
                        "prod-oxu3iqwrwktjm",
                        "prod-pjfguoisodbd6",
                        "prod-qco655ut2vn54",
                        "prod-vznp63pbdpexe",
                        "prod-xdkflymybwmvi",
                        "prod-xynumvnbsn34g",
                        "prod-zpwu74hhojefo"
                      ]
                    }
                  }
                },
                {
                  "Sid": "ViewMarketplaceSubscriptions",
                  "Effect": "Allow",
                  "Action": "aws-marketplace:ViewSubscriptions",
                  "Resource": "*"
                },
                {
                  "Sid": "ReadOwnStackVersion",
                  "Effect": "Allow",
                  "Action": "cloudformation:DescribeStacks",
                  "Resource": { "Ref": "AWS::StackId" }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Description": "The role the app assumes.",
      "Value": { "Fn::GetAtt": ["ModelCallerRole", "Arn"] }
    },
    "TemplateVersion": {
      "Description": "The version of this template, read by the app.",
      "Value": "1.1.0"
    }
  }
}
