{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Chief of staff: one role the app can assume, only with this account's external ID, that can call Amazon Bedrock models and accept a model's AWS Marketplace terms on its first call. Delete this stack to remove the app's access.",
  "Metadata": {
    "TemplateVersion": "1.1.0"
  },
  "Parameters": {
    "ExternalId": {
      "Type": "String",
      "Description": "The external ID the app generated for this account (not secret). Filled in by the app's link.",
      "MinLength": 2,
      "MaxLength": 1224,
      "AllowedPattern": "[\\w+=,.@:\\/-]*"
    },
    "AppRoleArn": {
      "Type": "String",
      "Description": "The app's own role, the only principal this role trusts. Filled in by the app's link.",
      "AllowedPattern": "arn:aws:iam::\\d{12}:role/[\\w+=,.@/-]+"
    }
  },
  "Resources": {
    "ModelCallerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "chief-of-staff-model-caller",
        "Description": "Lets the Chief of staff app call Amazon Bedrock models and accept a model's AWS Marketplace terms on its first call, and nothing else.",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "AWS": { "Ref": "AppRoleArn" } },
              "Action": "sts:AssumeRole",
              "Condition": { "StringEquals": { "sts:ExternalId": { "Ref": "ExternalId" } } }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "invoke-models-only",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "InvokeModels",
                  "Effect": "Allow",
                  "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
                  "Resource": [
                    "arn:aws:bedrock:*::foundation-model/*",
                    "arn:aws:bedrock:*:*:inference-profile/*",
                    "arn:aws:bedrock:*:*:application-inference-profile/*"
                  ]
                },
                {
                  "Sid": "AcceptModelTermsOnFirstCall",
                  "Effect": "Allow",
                  "Action": ["aws-marketplace:Subscribe", "aws-marketplace:Unsubscribe", "aws-marketplace:ViewSubscriptions"],
                  "Resource": "*"
                },
                {
                  "Sid": "ReadOwnStackVersion",
                  "Effect": "Allow",
                  "Action": "cloudformation:DescribeStacks",
                  "Resource": { "Ref": "AWS::StackId" }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Description": "The role the app assumes.",
      "Value": { "Fn::GetAtt": ["ModelCallerRole", "Arn"] }
    },
    "TemplateVersion": {
      "Description": "The version of this template, read by the app.",
      "Value": "1.1.0"
    }
  }
}
